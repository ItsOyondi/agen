# print(capital())
class PrimeCounter {
    fn count_primes(limit) {
        count = 0
        for i in range(limit) {
            if i % 2 != 0 { count = count + 1 }
        }
        return count
    }
    fn count_primes_parallel(limits) {    
        return pmap(self.count_primes, limits)
    }
}

let counter = PrimeCounter()
print(counter.count_primes_parallel([100000, 100000, 100000, 100000]))  # several cores
print(counter.count_primes(200000))          # this function runs in C++