{
  "name": "agen",
  "displayName": "Agen",
  "description": "Syntax highlighting for the Agen language (.agn)",
  "version": "0.2.0",
  "publisher": "agen-lang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages", "Themes"],
  "configurationDefaults": {
    "workbench.iconTheme": "agen-seti"
  },
  "contributes": {
    "languages": [
      {
        "id": "agen",
        "aliases": ["Agen", "agen"],
        "extensions": [".agn"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/agen.svg",
          "dark": "./icons/agen.svg"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "agen-seti",
        "label": "Seti (Agen)",
        "path": "./icons/agen-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "agen",
        "scopeName": "source.agen",
        "path": "./syntaxes/agen.tmLanguage.json"
      }
    ]
  }
}
